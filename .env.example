# 复制为 .env 后再用于生产或 Docker；不要把真实令牌提交到版本库。
APP_ENV=production
DEMO_MODE=false
ADMIN_API_TOKEN=请替换为至少32位随机字符串
DATA_RETENTION_DAYS=30
# 留空时从证据登记表的最新 reviewed_at 自动推导。
POLICY_AS_OF=

# deterministic：只用可复现规则；ollama：启用结构化大模型抽取；hybrid：再启用语义召回。
AI_MODE=deterministic
OLLAMA_URL=http://127.0.0.1:11434
# 默认禁止把可能含个人情况的提示发送到远程主机。
ALLOW_REMOTE_OLLAMA=false
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SECONDS=120

OCR_ENABLED=true
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=40000000
MAX_PACKAGE_FILES=12
MAX_PDF_PAGES=12
MAX_PACKAGE_BYTES=33554432
MAX_PACKAGE_PAGES=36
DOCUMENT_TIMEOUT_SECONDS=30
PACKAGE_TIMEOUT_SECONDS=60
MAX_LLM_WORKERS=2
MAX_DOCUMENT_WORKERS=2
MAX_WORK_QUEUE=16
