# 复制为 .env 后再用于生产或 Docker；不要把真实令牌提交到版本库。
APP_ENV=production
DEMO_MODE=false
ADMIN_API_TOKEN=请替换为至少32位随机字符串
DATA_RETENTION_DAYS=30
# 留空时从证据登记表的最新 reviewed_at 自动推导。
POLICY_AS_OF=

# deterministic：只用可复现规则；ollama：启用结构化大模型抽取；hybrid：再启用语义召回。
AI_MODE=deterministic
OLLAMA_URL=http://127.0.0.1:11434
# 默认禁止把可能含个人情况的提示发送到远程主机。
ALLOW_REMOTE_OLLAMA=false
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_MODEL_DIGEST=0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBED_MODEL_DIGEST=ac6da0dfba84a81fdbfbaf330198c33cd77c4cdfc53e8bc50eb581914a15621d
OLLAMA_TIMEOUT_SECONDS=120

OCR_ENABLED=true
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=40000000
MAX_PACKAGE_FILES=12
MAX_PDF_PAGES=12
MAX_PACKAGE_BYTES=33554432
MAX_PACKAGE_PAGES=36
# multipart边界与字段的请求级预留；总请求在解析前按业务上限+该值拒绝。
MULTIPART_OVERHEAD_BYTES=1048576
DOCUMENT_TIMEOUT_SECONDS=30
PACKAGE_TIMEOUT_SECONDS=60
MAX_LLM_WORKERS=2
MAX_DOCUMENT_WORKERS=2
MAX_WORK_QUEUE=16

# 最小告警阈值；治理接口会返回当前触发项，不包含用户原始输入。
ALERT_REQUEST_P95_MS=2000
ALERT_LLM_P95_MS=10000
ALERT_OCR_P95_MS=15000
ALERT_QUEUE_DEPTH=12
ALERT_HTTP_5XX_RATE=0.05
